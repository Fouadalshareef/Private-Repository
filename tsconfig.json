{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"],
      "@core/*": ["./src/core/*"],
      "@events/*": ["./src/events/*"],
      "@config/*": ["./src/config/*"],
      "@logging/*": ["./src/logging/*"],
      "@bootstrap/*": ["./src/bootstrap/*"],
      "@plugins/*": ["./src/plugins/*"],
      "@workspace/*": ["./src/workspace/*"],
      "@filesystem/*": ["./src/filesystem/*"],
      "@project/*": ["./src/project/*"],
      "@model/*": ["./src/model/*"],
      "@source/*": ["./src/source/*"],
      "@language/*": ["./src/language/*"],
      "@ai/*": ["./src/ai/*"],
      "@prompt/*": ["./src/prompt/*"],
      "@types/*": ["./src/types/*"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests/**/*.ts"]
}
