{
  "name": "cupaw-core",
  "version": "0.1.0",
  "private": true,
  "description": "Cupaw AI Platform Core Foundation",
  "type": "module",
  "main": "./dist/electron/main.js",
  "bin": {
    "cupaw": "./src/bin/cupaw.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsc --watch",
    "desktop": "npm run build && electron .",
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run format && npm run lint && npm run build && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "electron": "^43.4.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
